# ===========================
# MySQL Configuration
# ===========================
# Docker Compose 실행 시 사용되는 MySQL 환경변수입니다.
# 이 파일을 .env로 복사한 뒤 값을 채워서 사용하세요:
#   cp .env.example .env

MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=promptdeck
MYSQL_USER=promptdeck
MYSQL_PASSWORD=changeme_user_password
MYSQL_PORT=3306

# ===========================
# Backend Configuration
# ===========================
# JWT 서명용 비밀키 (32자 이상 랜덤 문자열 권장)
JWT_SECRET=changeme_jwt_secret_at_least_32_chars_long

# 백엔드 포트 (기본 8080)
BACKEND_PORT=8080

# ===========================
# Frontend Configuration
# ===========================
# 프론트엔드 포트 (기본 3000)
FRONTEND_PORT=3000

# 브라우저에서 접근하는 프론트엔드 Origin 목록
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
